RewriteEngine On

# Force HTTPS (uncomment when HTTPS is available on your hosting)
#RewriteCond %{HTTPS} !=on
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Optional: Strict-Transport-Security (aktifkan setelah HTTPS stabil)
#<IfModule mod_headers.c>
#  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
#</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), fullscreen=(self)"
  # CSP to allow our static site and Supabase
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.supabase.co https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.jsdelivr.net/npm/@supabase/supabase-js; connect-src 'self' https://*.supabase.co; font-src 'self' https://cdn.jsdelivr.net; frame-ancestors 'self';"
</IfModule>

# Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType video/ogg "access plus 30 days"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/css application/javascript application/json
</IfModule>